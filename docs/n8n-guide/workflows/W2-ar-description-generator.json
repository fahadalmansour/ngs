{
  "name": "W2 — AR description generator",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "30 3 * * *" }] }
      },
      "id": "cron",
      "name": "Daily 03:30 Riyadh",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "https://neogen.store/wp-json/neogen/v1/products?missing=ar_description&limit=5",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBasicAuth"
      },
      "id": "fetch",
      "name": "Fetch 5 pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [420, 300],
      "credentials": {
        "httpBasicAuth": { "id": "neogen-rest", "name": "neogen-rest n8n-bot" }
      }
    },
    {
      "parameters": { "fieldToSplitOut": "items", "options": {} },
      "id": "split",
      "name": "Per product",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "url": "http://192.168.8.106:11434/api/generate",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen2.5:14b\",\n  \"prompt\": \"You are writing the Arabic product description for an electronics e-commerce site in Saudi Arabia. Output ONE Arabic paragraph, 60-100 words, no headings, no bullets, no English. Keep brand names and model numbers in Latin script. Tone: confident, technical, neutral. No emojis.\\n\\nProduct title: \" + $json.title_en + \"\\n\\nReference body: \" + ($json.body_en || '').slice(0, 800),\n  \"stream\": false,\n  \"options\": { \"temperature\": 0.3, \"num_predict\": 350 }\n}",
        "options": { "timeout": 90000 }
      },
      "id": "ollama",
      "name": "Ollama — generate AR body",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [860, 300]
    },
    {
      "parameters": {
        "jsCode": "const ar = ($json.response || '').trim();\nconst arChars = (ar.match(/[\\u0600-\\u06FF]/g) || []).length;\nconst total = ar.replace(/\\s+/g, '').length;\nif (arChars < 30) throw new Error('AR coverage too low');\nif (total > 0 && (arChars / total) < 0.7) throw new Error('AR ratio < 70%, output is mostly non-Arabic');\nreturn { json: { ...$('Per product').item.json, ar_description: ar } };"
      },
      "id": "validate",
      "name": "Validate AR body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "url": "=https://neogen.store/wp-json/neogen/v1/products/{{ $json.id }}/ar-description",
        "method": "POST",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"ar_description\": $json.ar_description,\n  \"source\": \"ollama-qwen2.5:14b\"\n}"
      },
      "id": "post",
      "name": "POST ar-description",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1300, 300],
      "credentials": {
        "httpBasicAuth": { "id": "neogen-rest", "name": "neogen-rest n8n-bot" }
      }
    }
  ],
  "connections": {
    "Daily 03:30 Riyadh":     { "main": [[{ "node": "Fetch 5 pending", "type": "main", "index": 0 }]] },
    "Fetch 5 pending":        { "main": [[{ "node": "Per product",     "type": "main", "index": 0 }]] },
    "Per product":            { "main": [[{ "node": "Ollama — generate AR body", "type": "main", "index": 0 }]] },
    "Ollama — generate AR body":   { "main": [[{ "node": "Validate AR body", "type": "main", "index": 0 }]] },
    "Validate AR body":       { "main": [[{ "node": "POST ar-description", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["neogen", "ar-content"]
}
